rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{userId} {
   allow read, write: if request.auth != null && request.auth.uid == userId;
  }
  // Comunidade: só quem está logado lê; cada um escreve só o que é seu.
  match /posts/{postId} {
   allow read: if request.auth != null;
   allow create: if request.auth != null
     && request.resource.data.uid == request.auth.uid
     && request.resource.data.text is string
     && request.resource.data.text.size() > 0
     && request.resource.data.text.size() <= 500
     && request.resource.data.type in ['text','checkin','trick','challenge','combo','robot','event'];
   allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
   allow update: if false;
  }
  // "Tô dentro": cada pessoa marca só a própria presença (id = evento__uid).
  match /went/{docId} {
   allow read: if request.auth != null;
   allow create, update: if request.auth != null
     && request.resource.data.uid == request.auth.uid
     && docId == request.resource.data.eventKey + '__' + request.auth.uid;
   allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
  }
  // Perfil público: quem está logado vê; cada um escreve só o seu.
  match /profiles/{userId} {
   allow read: if request.auth != null;
   allow write: if request.auth != null && request.auth.uid == userId;
  }
  match /checkins/{userId} {
   allow read: if request.auth != null;
   allow write: if request.auth != null && request.auth.uid == userId;
  }
  match /articles/{articleId} {
   allow read: if true;
   allow write: if false; // publish only via trusted backend/admin
   match /likes/{userId} {
    allow read: if true;
    allow create, delete: if request.auth != null && request.auth.uid == userId;
    allow update: if false;
   }
  }
 }
}
